{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!fixtures/casework/cases",
      "!fixtures/casework/watchlist",
      "!fixtures/casework/out",
      "!public/name-extraction/replays",
      "!public/operator/replays",
      "!src/features/operator/server/sandbox/screen-bundle.generated.ts",
      "!fixtures/loupe",
      "!public/loupe/samples",
      "!src/features/loupe/**/*.generated.json",
      "!fixtures/canvas/catalog.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
