# Template. install.sh fills in the @...@ placeholders and writes the result to
# /etc/systemd/system/harness-sandbox.service. Do not install this file as is.
#
# What the hardening does and does not buy: the Runner must talk to the Docker
# socket, and whoever can do that can become root on the host. So these
# settings contain a bug in the Runner process itself (no shell, no home
# directories, no outbound network, read-only file system). They do not
# contain an attacker who can make the Runner send arbitrary docker commands.

[Unit]
Description=Harness Sandbox Runner (starts and drives Sandboxes in Docker)
Documentation=file://@INSTALL_DIR@/README.md
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=@USER@
Group=@USER@
SupplementaryGroups=docker
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@ENV_FILE@
# The docker CLI wants a home for its config; nothing else is written anywhere.
StateDirectory=harness-sandbox
StateDirectoryMode=0700
Environment=HOME=/var/lib/harness-sandbox
Environment=DOCKER_CONFIG=/var/lib/harness-sandbox/.docker
Environment=NODE_ENV=production
ExecStart=@NODE@ @INSTALL_DIR@/runner.mjs
Restart=on-failure
RestartSec=3
# On SIGTERM the Runner removes every Sandbox, then exits.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=45

# Resources of the Runner itself (the Sandboxes are limited by Docker).
MemoryMax=384M
TasksMax=512
LimitNOFILE=4096

# Hardening.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Loopback for the listener (Caddy is in front), a unix socket for Docker. Nothing else.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
# Not set, on purpose:
#   MemoryDenyWriteExecute  Node's JIT needs writable-then-executable memory.
#   PrivateNetwork          Caddy must reach 127.0.0.1:RUNNER_PORT.
#   DynamicUser             the user must be a stable member of the docker group.

[Install]
WantedBy=multi-user.target
