/**
 * Bundles the Canvas View App (src/features/canvas/app, Preact) into ONE
 * self-contained HTML document with inline script and style, and writes it as
 * a string to src/features/canvas/app/view-app.generated.ts. The MCP server
 * returns that string as the resource `ui://canvas/view.html`.
 *
 *   pnpm build:canvas-app
 */
import { readFile, writeFile } from "node:fs/promises";
import { join } from "node:path";
import { build } from "esbuild";

const ROOT = join(import.meta.dirname, "..");
const APP = join(ROOT, "src/features/canvas/app");

const [js, css] = await Promise.all([
  build({
    entryPoints: [join(APP, "main.tsx")],
    bundle: true,
    minify: true,
    format: "iife",
    target: "es2020",
    jsx: "automatic",
    jsxImportSource: "preact",
    write: false,
    legalComments: "none",
  }),
  build({
    entryPoints: [join(APP, "view-app.css")],
    bundle: true,
    minify: true,
    write: false,
    loader: { ".css": "css" },
  }),
]);

// A closing tag inside the script or style would end the element early.
const script = js.outputFiles[0].text.replaceAll("</script", "<\\/script");
const style = css.outputFiles[0].text.replaceAll("</style", "<\\/style");

const html = `<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Canvas View</title>
<style>${style}</style>
</head>
<body>
<div id="app"></div>
<script>${script}</script>
</body>
</html>
`;

const out = `// biome-ignore-all lint/suspicious/noTemplateCurlyInString: the bundle's own template strings.
// Generated by scripts/build-canvas-app.mts. Do not edit: run \`pnpm build:canvas-app\`.
/** The Canvas View App: one self-contained HTML document (MCP App resource). */
export const VIEW_APP_HTML: string = ${JSON.stringify(html)};
export const VIEW_APP_BYTES = ${Buffer.byteLength(html)};
`;

const target = join(APP, "view-app.generated.ts");
const before = await readFile(target, "utf8").catch(() => "");
if (before !== out) await writeFile(target, `${out.trimEnd()}\n`);
console.log(`view-app.generated.ts: ${Buffer.byteLength(html)} bytes`);
