/**
 * Builds what the Harness Knowledge base ships with, from files in the repo:
 *
 *  1. `src/features/harness/domain/knowledge/seed-texts.ts`, the seed Sources
 *     as TypeScript strings, from `fixtures/harness/knowledge/*.md` (a Vercel
 *     function cannot read arbitrary repo files at runtime; the seed's order
 *     and metadata live in `seed.ts`).
 *  2. `public/harness/samples/kb-pensions-circular-2023-07.pdf`, a one-page
 *     text PDF written by hand.
 *  3. `public/harness/samples/kb-fees-and-limits.xlsx`, a two-sheet workbook
 *     built with fflate, as the Client Manager's sample workbook is.
 *
 *   node --experimental-strip-types scripts/build-harness-knowledge.mts
 */
import { readdirSync, readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { strToU8, zipSync } from "fflate";

const ROOT = join(import.meta.dirname, "..");
const FIXTURES = join(ROOT, "fixtures/harness/knowledge");
const SAMPLES = join(ROOT, "public/harness/samples");

// 1. Seed texts --------------------------------------------------------------------

const files = readdirSync(FIXTURES)
  .filter((name) => name.endsWith(".md"))
  .sort();
const entries = files.map((name) => {
  const key = name.replace(/\.md$/, "");
  const text = readFileSync(join(FIXTURES, name), "utf8").trimEnd();
  return `  ${JSON.stringify(key)}: ${JSON.stringify(text)},`;
});
writeFileSync(
  join(ROOT, "src/features/harness/domain/knowledge/seed-texts.ts"),
  `// GENERATED by scripts/build-harness-knowledge.mts from fixtures/harness/knowledge/*.md. Do not edit.
export const SEED_TEXTS: Record<string, string> = {
${entries.join("\n")}
};
`,
);

// 2. The Circular, as a PDF ---------------------------------------------------------

type Line = { text: string; bold?: boolean; size?: number; gap?: number };

const CIRCULAR: Line[] = [
  { text: "HARBOUR BANK & TRUST", bold: true, size: 15 },
  {
    text: "Pensions Circular 2023-07 (SPECIMEN, a fictional bank)",
    bold: true,
    size: 12,
    gap: 6,
  },
  { text: "Date: 1 December 2023" },
  { text: "To: Pensions Operations Desk, all officers" },
  {
    text: "Subject: Property withdrawals: new maximum amounts from 9 December 2023",
    bold: true,
    gap: 10,
  },
  {
    text: "1. The National Pensions (Amendment) Act, 2023 (Act 23 of 2023) comes into force on 9 December 2023.",
    gap: 4,
  },
  {
    text: "2. From 9 December 2023 the most a Caymanian may withdraw from mandatory pension money for housing is CI$50,000 for a deposit or a reduction payment on an existing mortgage, and CI$100,000 to pay off an existing mortgage in full. The amounts are measured across all of the person's plans.",
    gap: 4,
  },
  {
    text: "3. The previous maximum of CI$35,000 no longer applies to an application made on or after 9 December 2023.",
    gap: 4,
  },
  {
    text: "4. The application fee, if one is charged, is at most CI$50. The cheque is paid to the lender, never to the member.",
    gap: 4,
  },
  {
    text: "5. Member guides printed before this date state the earlier maximum. Officers should not quote them for an application made on or after 9 December 2023.",
    gap: 10,
  },
  {
    text: "Illustrative, not legal advice. The National Pensions Act (2024 Revision), Part 7A, is the authority.",
    size: 9,
  },
];

const wrap = (text: string, width: number) => {
  const words = text.split(" ");
  const lines: string[] = [];
  let line = "";
  for (const word of words) {
    if (line && line.length + word.length + 1 > width) {
      lines.push(line);
      line = word;
    } else {
      line = line ? `${line} ${word}` : word;
    }
  }
  if (line) lines.push(line);
  return lines;
};

const pdfString = (text: string) =>
  text.replace(/\\/g, "\\\\").replace(/\(/g, "\\(").replace(/\)/g, "\\)");

function buildPdf(lines: Line[]): Uint8Array {
  let y = 790;
  const ops: string[] = [];
  for (const line of lines) {
    const size = line.size ?? 11;
    const font = line.bold ? "F2" : "F1";
    for (const part of wrap(line.text, Math.floor(88 * (11 / size)))) {
      ops.push(`BT /${font} ${size} Tf 56 ${y} Td (${pdfString(part)}) Tj ET`);
      y -= size * 1.45;
    }
    y -= line.gap ?? 0;
  }
  const stream = ops.join("\n");
  const objects = [
    "<< /Type /Catalog /Pages 2 0 R >>",
    "<< /Type /Pages /Kids [3 0 R] /Count 1 >>",
    "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents 4 0 R /Resources << /Font << /F1 5 0 R /F2 6 0 R >> >> >>",
    `<< /Length ${stream.length} >>\nstream\n${stream}\nendstream`,
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>",
    "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica-Bold /Encoding /WinAnsiEncoding >>",
  ];
  let out = "%PDF-1.4\n";
  const offsets: number[] = [];
  objects.forEach((body, index) => {
    offsets.push(out.length);
    out += `${index + 1} 0 obj\n${body}\nendobj\n`;
  });
  const xref = out.length;
  out += `xref\n0 ${objects.length + 1}\n0000000000 65535 f \n`;
  for (const offset of offsets)
    out += `${String(offset).padStart(10, "0")} 00000 n \n`;
  out += `trailer\n<< /Size ${objects.length + 1} /Root 1 0 R >>\nstartxref\n${xref}\n%%EOF\n`;
  return Uint8Array.from(Buffer.from(out, "latin1"));
}

writeFileSync(
  join(SAMPLES, "kb-pensions-circular-2023-07.pdf"),
  buildPdf(CIRCULAR),
);

// 3. The fees workbook ----------------------------------------------------------------

type Cell = string | number;
const escapeXml = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const column = (index: number) => String.fromCharCode(65 + index);

function sheetXml(rows: Cell[][]) {
  const body = rows
    .map(
      (cells, r) =>
        `<row r="${r + 1}">${cells
          .map((value, c) => {
            const ref = `${column(c)}${r + 1}`;
            return typeof value === "number"
              ? `<c r="${ref}"><v>${value}</v></c>`
              : `<c r="${ref}" t="inlineStr"><is><t xml:space="preserve">${escapeXml(value)}</t></is></c>`;
          })
          .join("")}</row>`,
    )
    .join("");
  return `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>${body}</sheetData></worksheet>`;
}

const SHEETS: { name: string; rows: Cell[][] }[] = [
  {
    name: "Rates",
    rows: [
      ["Item", "Rate or amount", "Applies to", "Source"],
      [
        "Employer contribution",
        "5% of earnings (minimum)",
        "Monthly, up to the YMPE",
        "National Pensions Act s.47(3)",
      ],
      [
        "Employee contribution",
        "up to 5% of earnings",
        "Monthly, up to the YMPE",
        "National Pensions Act s.47(3)",
      ],
      [
        "Year's Maximum Pensionable Earnings",
        "CI$87,000 per year",
        "Mandatory contributions",
        "National Pensions Act s.3",
      ],
      [
        "Contribution due date",
        "15th of the following month",
        "Every month of service",
        "National Pensions Act s.48(2)-(3)",
      ],
      [
        "Late interest",
        "Cayman prime rate plus 5%, daily",
        "From the day after the due date",
        "National Pensions Act s.50",
      ],
    ],
  },
  {
    name: "Fees and limits",
    rows: [
      ["Item", "Limit (CI$)", "Notes"],
      [
        "Property withdrawal application fee",
        50,
        "At most; the plan may charge less or nothing",
      ],
      [
        "Small balance lump sum",
        5000,
        "Under this amount the administrator may pay a single lump sum",
      ],
      ["AVC early access", 4, "Times per calendar year"],
      [
        "RSA annual floor from 1 July 2026",
        16200,
        "Or the age-based percentage if higher",
      ],
    ],
  },
];

const workbook = zipSync({
  "[Content_Types].xml": strToU8(
    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Default Extension="xml" ContentType="application/xml"/><Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>${SHEETS.map((_, i) => `<Override PartName="/xl/worksheets/sheet${i + 1}.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>`).join("")}</Types>`,
  ),
  "_rels/.rels": strToU8(
    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/></Relationships>`,
  ),
  "xl/workbook.xml": strToU8(
    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<workbook xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships"><sheets>${SHEETS.map((sheet, i) => `<sheet name="${escapeXml(sheet.name)}" sheetId="${i + 1}" r:id="rId${i + 1}"/>`).join("")}</sheets></workbook>`,
  ),
  "xl/_rels/workbook.xml.rels": strToU8(
    `<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">${SHEETS.map((_, i) => `<Relationship Id="rId${i + 1}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet${i + 1}.xml"/>`).join("")}</Relationships>`,
  ),
  ...Object.fromEntries(
    SHEETS.map((sheet, i) => [
      `xl/worksheets/sheet${i + 1}.xml`,
      strToU8(sheetXml(sheet.rows)),
    ]),
  ),
});
writeFileSync(join(SAMPLES, "kb-fees-and-limits.xlsx"), workbook);

console.log(
  `Wrote ${files.length} seed texts, the Circular PDF and the fees workbook.`,
);
