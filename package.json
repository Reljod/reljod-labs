{
  "name": "reljod-labs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "biome format --write",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sql": "supabase/tests/run-document-compliance-rules-audit.sh",
    "test:bank-db": "supabase/tests/run-bank.sh",
    "test:e2e:record": "E2E_RECORD=1 playwright test",
    "seed:document-compliance": "node --env-file=.env.local scripts/seed-document-compliance.mts",
    "seed:casework": "NODE_USE_ENV_PROXY=1 node scripts/seed-casework.mts",
    "render:casework": "node fixtures/casework/render.mjs",
    "render:client-manager-samples": "node --experimental-strip-types scripts/render-client-manager-samples.mts",
    "render:process-transfer-samples": "node --experimental-strip-types scripts/render-process-transfer-samples.mts",
    "render:vellum-samples": "node --experimental-strip-types scripts/render-vellum-samples.mts",
    "seed:client-manager": "node --env-file-if-exists=.env.local scripts/seed-client-manager.mts",
    "render:name-extraction-corpus": "node --experimental-strip-types scripts/render-name-extraction-corpus.mts",
    "eval:name-extraction": "node --env-file-if-exists=.env.local scripts/eval-name-extraction.mts",
    "build:operator-screen": "node --experimental-strip-types scripts/build-operator-screen.mts",
    "record:operator-replay": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/record-operator-replay.mts",
    "render:loupe-corpus": "node --experimental-strip-types scripts/render-loupe-corpus.mts && node --experimental-strip-types scripts/build-loupe-data.mts",
    "eval:loupe": "node --experimental-strip-types scripts/eval-loupe.mts",
    "render:canvas-data": "node --experimental-strip-types scripts/render-canvas-data.mts",
    "build:canvas-app": "node --experimental-strip-types scripts/build-canvas-app.mts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.93",
    "@modelcontextprotocol/server": "^2.4.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/sandbox": "^3.9.1",
    "@vercel/speed-insights": "^2.1.0",
    "@xyflow/react": "^12.12.1",
    "ai": "^7.0.163",
    "fflate": "^0.8.3",
    "mcp-handler": "^2.3.1",
    "motion": "^14.10.1",
    "next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "workflow": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "preact": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.18.0"
}
